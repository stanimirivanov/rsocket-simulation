{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["image", "simulation"],
  "properties": {
    "simulation": {
      "type": "object",
      "required": ["serverUri", "route", "shards", "parallelism", "connectionsPerShard"],
      "properties": {
        "serverUri": {"type": "string", "pattern": "^wss?://"},
        "route": {"type": "string", "minLength": 1},
        "shards": {"type": "integer", "minimum": 1},
        "parallelism": {"type": "integer", "minimum": 1},
        "connectionsPerShard": {"type": "integer", "minimum": 1}
      }
    }
  }
}
